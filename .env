# =====================================================================
#  智析 FinSight AI —— 公共配置（随代码提交，密钥一律留空）
#  本机私密配置请写入同目录 .env.local（已在 .gitignore 中忽略）
#  加载优先级：系统环境变量 > .env.local > .env > 代码默认值
# =====================================================================

# ------------------------- 数据库 -------------------------
# sqlite = 零依赖演示模式（默认）；mysql = 正式模式
DB_DIALECT=sqlite

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=loan_system
MYSQL_CHARSET=utf8mb4

SQLITE_PATH=data/loan_system.db

# ------------------------- 应用 -------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
SECRET_KEY=dev-only-change-me
# 演示数据的密码哈希按此盐值预置，修改后需重新执行 init_db.py
PASSWORD_SALT=loan_system_salt

# ------------------------- 业务规则 -------------------------
# 借资超过 N 个月未还 => 逾期，进入催还流程
OVERDUE_MONTHS=3
COLLECTION_LEVEL2_DAYS=90
COLLECTION_LEVEL3_DAYS=180
COLLECTION_INTERVAL_DAYS=7

# ------------------------- 大语言模型（OpenAI 兼容接口） -------------------------
# 密钥请写入 .env.local，不要写在这里
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_FALLBACK_ENABLED=true

# ------------------------- 短信平台 -------------------------
# none = 无短信平台（记录标记并置人工补发）；mock = 模拟发送；http = 真实 HTTP 网关
SMS_PROVIDER=mock
SMS_SIGN_NAME=【示例公司】
SMS_TEMPLATE_CODE=
SMS_ENDPOINT=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# ------------------------- AI 助手 -------------------------
ASSISTANT_MAX_ROWS=200

# =====================================================================
#  智析 FinSight AI  环境配置示例
#  使用方式：复制本文件为 .env，按实际环境修改后启动系统
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Linux / macOS)
# =====================================================================

# ------------------------- Flask 应用 -------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=true
SECRET_KEY=loan-collection-system-secret-key-2025
PASSWORD_SALT=loan_system_salt

# ------------------------- 数据库 -------------------------
# mysql  = 课程设计正式环境（需先执行《数据库SQL脚本》建库建表）
# sqlite = 本地零依赖演示环境（执行 python init_db.py sqlite 初始化）
DB_DIALECT=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=loan_system
MYSQL_CHARSET=utf8mb4

SQLITE_PATH=data/loan_system.db

# ------------------------- 业务规则 -------------------------
# 借资超过 N 个月未还 => 逾期，进入催还流程（课程设计要求：3 个月）
OVERDUE_MONTHS=3
# 催还分级：逾期天数阈值
COLLECTION_LEVEL2_DAYS=90
COLLECTION_LEVEL3_DAYS=180
# 同一笔借资同级催还的最小间隔天数（防止重复催还）
COLLECTION_INTERVAL_DAYS=7

# ------------------------- 大语言模型（OpenAI 兼容接口） -------------------------
# 支持 DeepSeek / 通义千问 / 智谱 GLM / Kimi / OpenAI 等兼容服务
# 未填写 LLM_API_KEY 时系统自动降级为内置规则引擎，功能不受影响
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_FALLBACK_ENABLED=true

# ------------------------- 短信平台 -------------------------
# none = 未接入短信平台（催还记录中做标识，提示人工补发）
# mock = 模拟发送成功（课堂演示完整闭环）
# http = 通用 HTTP 短信网关（配置下方 ENDPOINT 与密钥）
SMS_PROVIDER=none
SMS_SIGN_NAME=【示例公司】
SMS_TEMPLATE_CODE=
SMS_ENDPOINT=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# ------------------------- AI 助手 -------------------------
ASSISTANT_MAX_ROWS=200
